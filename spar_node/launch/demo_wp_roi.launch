<?xml version='1.0'?>
<launch>
	<node name="guidance" pkg="spar_node" type="demo_wp_roi" respawn="false" output="screen">
		<!-- Matt 1.9.26 -->
		<!--Drone Altitude will be found in demo_wp_roi scripts, value changes drone height -->	
		<param name="DroneAlt" type="double" value="1.5" />

		<!-- Linear and yaw motion velocities -->
		<param name="vel_linear" type="double" value="0.4" /> 
		<param name="vel_yaw" type="double" value="0.2" />

		<!-- Position and yaw waypoint accuracies -->
		<param name="acc_pos" type="double" value="0.05" />
		<param name="acc_yaw" type="double" value="0.1" />

		<!-- Matt 1.9.26 Safe boundary values for 0134 -->
		<param name="safeRangeX" type="double" value="4.5" />
		<param name="safeRangeY" type="double" value="4.5" />
		<param name="safeRangeZ" type="double" value="4" />
		
		<!-- Spar parameters -->
		<param name="action_topic" type="string" value="spar/flight" />

		<!-- Chris 2.10.26, Real UAV uses "/mavros/local_position/pose" -->
		<!-- Remappings -->
		<remap from="~/pose" to="/mavros/local_position/pose" />
		<remap from="~/roi" to="target_detection/roi" />
	</node>
</launch>
